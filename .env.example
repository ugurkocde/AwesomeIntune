# Copy to .env and fill in real values. Never commit .env files.
# Validated by src/env.js; empty strings are treated as missing.

# App
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# NODE_ENV is supplied by Next.js (development for dev, production for build
# and start) and is validated by src/env.js. Leave it unset here.
# NODE_ENV="development"

# Supabase (server). Use the service role key on the server only.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# Email (Resend)
RESEND_API_KEY=""

# GitHub (read-only token used for repo stats and submissions)
GITHUB_TOKEN=""

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Optional: secret used to sign the voter cookie. Falls back to the
# Supabase service role key when unset.
VOTER_SECRET=""
