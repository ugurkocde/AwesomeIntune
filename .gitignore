# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage
/output/playwright/

# database
/prisma/db.sqlite
/prisma/db.sqlite-journal
db.sqlite

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# debug artifacts (root-level screenshots from browser testing, not public/ assets)
/.playwright-mcp/
/.playwright-cli/
/*.png
/*.jpg
/*.jpeg

# local env files
# Ignore every .env variant, including .env.production, but keep the template.
# https://create.t3.gg/en/usage/env-variables#using-environment-variables
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo

# idea files
.idea

# claude code
.claude/
